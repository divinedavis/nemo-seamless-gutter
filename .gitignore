# dependencies
node_modules/
server/node_modules/

# secrets / runtime config
.env
server/.env
*.env.local

# sqlite database + WAL files
*.sqlite
*.sqlite-*
server/bookings.sqlite*

# logs
*.log
npm-debug.log*

# os
.DS_Store
Thumbs.db

# python bytecode — the review agent runs the growth test suite from a checkout
__pycache__/
*.py[cod]

# SEO automation secrets + generated drafts
seo/.env
seo/drafts/
seo/used_topics.json
seo/gsc-service-account.json

# Growth engine runtime state. The copy on the droplet is the source of truth —
# it is the measurement history and the record of what was tried, and a stale
# checkout overwriting it would erase the year's findings. seed.py and
# keywords.py recreate the baseline on a fresh install.
growth/techniques.json
growth/keywords.json
growth/results.jsonl
growth/state.json
growth/.anthropic_key
growth/.elevenlabs_key
# Caller numbers for calls already identified — personal data, and rebuildable
# from the ElevenLabs API, so it stays on the droplet.
growth/calls_cache.json
# All-time visitor roster. Salted hashes of IP+UA, never the addresses
# themselves, but still audience data — and, like the ledger, a history the
# access log can no longer rebuild once it has rotated.
growth/audience.json
growth/audience.json.tmp
*.growth-bak
